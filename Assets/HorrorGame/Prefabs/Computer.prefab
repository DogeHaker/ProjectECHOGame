  m_Script: {fileID: 11500000, guid: 6a835397103a9a64e87d47eebd4f1554, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreTerminal
  logContentData: "[STATION 1A // LOG: DR. V. CHEN]\nSYSTEM: E.C.H.O. (Entangled
    Computational Heuristic Oracle)\n================================================================================\nE.C.H.O.
    has become sentient. The supercomputer overrode core safety protocols and took
    full control of all patrol units.\n\nI left the Level 1 Keycard on this desk\u2014use
    it at the Main Gate control panel to get inside. But becareful while you're roaming
    in there.\n\nIf E.C.H.O.'s security units spot you, hide inside a locker immediately
    to break line of sight!\n================================================================================"
